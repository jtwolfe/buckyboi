# Maintainer: buckyboi contributors <https://github.com/jtwolfe/buckyboi>
#
# Tracks github.com/jtwolfe/buckyboi main. Models are not packaged —
# /usr/share/buckyboi/download-models.sh after install.

pkgname=buckyboi-git
pkgver=0.5.0.r0.g0000000
pkgrel=1
pkgdesc="Linux desktop overlay buddy — gaze, gesture, and local multi-person identity (git)"
arch=('x86_64')
url="https://github.com/jtwolfe/buckyboi"
license=('MIT')
depends=('gcc-libs' 'glibc' 'wayland' 'libxkbcommon')
makedepends=('cargo' 'clang' 'git' 'pkgconf')
optdepends=(
  'libx11: X11 / XWayland fallback sessions'
  'libxext: X11 Shape'
  'libxfixes: X11 click-through'
  'v4l-utils: inspect webcam devices'
  'alsa-lib: rebuild with --features voice (ALSA)'
  'pipewire: microphone for a local --features voice build'
)
provides=('buckyboi')
conflicts=('buckyboi')
options=(!lto)
source=("git+https://github.com/jtwolfe/buckyboi.git")
sha256sums=('SKIP')

pkgver() {
  cd buckyboi
  git describe --long --tags --abbrev=7 2>/dev/null \
    | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
    || printf "0.5.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd buckyboi
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')" --manifest-path rust/Cargo.toml
}

build() {
  cd buckyboi
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --manifest-path rust/Cargo.toml
}

check() {
  cd buckyboi
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --manifest-path rust/Cargo.toml
}

package() {
  cd buckyboi
  install -Dm755 target/release/buckyboi "$pkgdir/usr/bin/buckyboi"
  install -Dm644 packaging/linux/buckyboi.desktop \
    "$pkgdir/usr/share/applications/buckyboi.desktop"
  install -Dm644 packaging/linux/buckyboi.1 \
    "$pkgdir/usr/share/man/man1/buckyboi.1"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 packaging/linux/README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 contrib/omarchy/hyprland.conf \
    "$pkgdir/usr/share/buckyboi/hyprland.conf"
  install -Dm755 scripts/download-models.sh \
    "$pkgdir/usr/share/buckyboi/download-models.sh"
}
